# Database & Cache (Managed: Supabase/Neon + Upstash/Aiven)
DATABASE_URL="postgresql://user:password@db-host.provider.com:5432/citable_prod?sslmode=require"
REDIS_URL="rediss://default:password@redis-host.provider.com:6379"

# Core App Secrets
JWT_SECRET="generate-a-secure-64-character-random-hex-string"
NODE_ENV="production"
PORT=4000

# Client App URLs
NEXT_PUBLIC_API_URL="https://api.citable.site"
NEXT_PUBLIC_APP_URL="https://app.citable.site"

# Optional External AI Engine Integration
OPENAI_API_KEY="sk-proj-..."
ANTHROPIC_API_KEY="sk-ant-..."
